-- Main history/forecast table: hr_monthly_metrics
Total Hires = SUM(hr_monthly_metrics[Hires])
Total Exits = SUM(hr_monthly_metrics[Exits])
Monthly Turnover Rate % = DIVIDE(AVERAGE(hr_monthly_metrics[TurnoverRatePct]), 100, 0)
Total Applications = SUM(hr_monthly_metrics[Applications])
Total Offers = SUM(hr_monthly_metrics[Offers])
Recruitment Offer-to-Application % = DIVIDE([Total Offers], [Total Applications], 0)
Requisition Count = SUM(hr_monthly_metrics[Requisitions])
Average Time to Fill (Days) = AVERAGE(hr_monthly_metrics[AverageTimeToFillDays])
Forecast Hiring Need = SUM(hr_monthly_metrics[ForecastHires])
Average Satisfaction = AVERAGE(hr_monthly_metrics[SatisfactionScore])
Average Performance Rating = AVERAGE(hr_monthly_metrics[PerformanceRating])
Average Training Hours = AVERAGE(hr_monthly_metrics[TrainingHours])

-- The input turnover values are percents, hence divide by 100 for percentage format.
-- ForecastHires is a headcount planning scenario, not machine-learning prediction.
-- Filter RecordType to distinguish Actual from Scenario Forecast data.
