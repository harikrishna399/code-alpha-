-- Main table: property_market_data
Average Sale Price = AVERAGE(property_market_data[AverageSalePrice])
Average Monthly Rent = AVERAGE(property_market_data[AverageMonthlyRent])
Estimated Annual Rent = [Average Monthly Rent] * 12
Gross Rental Yield % = DIVIDE([Estimated Annual Rent], [Average Sale Price], 0)
Total Listings = SUM(property_market_data[Listings])
Total Transactions = SUM(property_market_data[Transactions])
Demand to Supply Ratio = DIVIDE([Total Transactions], [Total Listings], 0)
Average Policy Rate % = DIVIDE(AVERAGE(property_market_data[PolicyRatePct]), 100, 0)
Sale Price Previous Month =
CALCULATE([Average Sale Price], DATEADD(DateTable[Date], -1, MONTH))
Sale Price MoM Change % =
DIVIDE([Average Sale Price] - [Sale Price Previous Month], [Sale Price Previous Month], 0)

-- Latitude/Longitude are approximate neighborhood centers for visualization practice.
-- Gross yield excludes vacancy, taxes, maintenance, finance and transaction costs.
-- This synthetic sample is not current-market research or a live listings feed.
