table student_performance
	measure 'Student Count' = DISTINCTCOUNT(student_performance[StudentID])
		formatString: #,##0

	measure 'Average Attendance %' = DIVIDE(AVERAGE(student_performance[AttendancePct]), 100, 0)
		formatString: 0.0%

	measure 'Average Math Score' = AVERAGE(student_performance[MathScore])
		formatString: 0.0

	measure 'Average Programming Score' = AVERAGE(student_performance[ProgrammingScore])
		formatString: 0.0

	measure 'Average Communication Score' = AVERAGE(student_performance[CommunicationScore])
		formatString: 0.0

	measure 'Average Overall Score' = DIVIDE([Average Math Score] + [Average Programming Score] + [Average Communication Score], 3, 0)
		formatString: 0.0

	measure 'Credits Attempted' = SUM(student_performance[CreditsAttempted])
		formatString: #,##0

	measure 'Credits Earned' = SUM(student_performance[CreditsEarned])
		formatString: #,##0

	measure 'Credit Completion %' = DIVIDE([Credits Earned], [Credits Attempted], 0)
		formatString: 0.0%

	measure 'Students Requiring Support' = CALCULATE(DISTINCTCOUNT(student_performance[StudentID]), student_performance[SupportFlag] = "Yes")
		formatString: #,##0

	column StudentID
		dataType: string
		summarizeBy: none
		sourceColumn: StudentID

	column AcademicYear
		dataType: int64
		summarizeBy: sum
		sourceColumn: AcademicYear

	column Term
		dataType: int64
		summarizeBy: sum
		sourceColumn: Term

	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	column YearOfStudy
		dataType: int64
		summarizeBy: sum
		sourceColumn: YearOfStudy

	column AttendancePct
		dataType: int64
		summarizeBy: sum
		sourceColumn: AttendancePct

	column MathScore
		dataType: int64
		summarizeBy: sum
		sourceColumn: MathScore

	column ProgrammingScore
		dataType: int64
		summarizeBy: sum
		sourceColumn: ProgrammingScore

	column CommunicationScore
		dataType: int64
		summarizeBy: sum
		sourceColumn: CommunicationScore

	column CreditsAttempted
		dataType: int64
		summarizeBy: sum
		sourceColumn: CreditsAttempted

	column CreditsEarned
		dataType: int64
		summarizeBy: sum
		sourceColumn: CreditsEarned

	column LibraryVisits
		dataType: int64
		summarizeBy: sum
		sourceColumn: LibraryVisits

	column LabHours
		dataType: int64
		summarizeBy: sum
		sourceColumn: LabHours

	column SupportFlag
		dataType: string
		summarizeBy: none
		sourceColumn: SupportFlag

	partition student_performance = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"StudentID", type text}, {"AcademicYear", Int64.Type}, {"Term", Int64.Type}, {"Department", type text}, {"YearOfStudy", Int64.Type}, {"AttendancePct", Int64.Type}, {"MathScore", Int64.Type}, {"ProgrammingScore", Int64.Type}, {"CommunicationScore", Int64.Type}, {"CreditsAttempted", Int64.Type}, {"CreditsEarned", Int64.Type}, {"LibraryVisits", Int64.Type}, {"LabHours", Int64.Type}, {"SupportFlag", type text}}, "en-US")
			in
				#"Changed Type"
