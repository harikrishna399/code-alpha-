table resource_allocation
	measure 'Lab Utilization %' = DIVIDE(SUM(resource_allocation[LabHoursUsed]), SUM(resource_allocation[LabCapacityHours]), 0)
		formatString: 0.0%

	measure 'Library Utilization %' = DIVIDE(SUM(resource_allocation[LibraryVisits]), SUM(resource_allocation[LibraryVisitsCapacity]), 0)
		formatString: 0.0%

	measure 'Total Resource Gap Score' = SUM(resource_allocation[ResourceGapScore])
		formatString: #,##0

	measure 'Faculty Gap' = SUM(resource_allocation[FacultyRecommended]) - SUM(resource_allocation[FacultyCount])
		formatString: #,##0

	measure 'Tutor Hour Gap' = SUM(resource_allocation[TutorHourGap])
		formatString: #,##0

	measure 'Students Supported' = SUM(resource_allocation[SupportFlagCount])
		formatString: #,##0

	column AcademicYear
		dataType: int64
		summarizeBy: sum
		sourceColumn: AcademicYear

	column Term
		dataType: int64
		summarizeBy: sum
		sourceColumn: Term

	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	column StudentCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: StudentCount

	column FacultyCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: FacultyCount

	column FacultyRecommended
		dataType: int64
		summarizeBy: sum
		sourceColumn: FacultyRecommended

	column LabCapacityHours
		dataType: int64
		summarizeBy: sum
		sourceColumn: LabCapacityHours

	column LabHoursUsed
		dataType: int64
		summarizeBy: sum
		sourceColumn: LabHoursUsed

	column LabUtilizationPct
		dataType: double
		summarizeBy: sum
		sourceColumn: LabUtilizationPct

	column LibraryVisits
		dataType: int64
		summarizeBy: sum
		sourceColumn: LibraryVisits

	column LibraryVisitsCapacity
		dataType: int64
		summarizeBy: sum
		sourceColumn: LibraryVisitsCapacity

	column LibraryUtilizationPct
		dataType: double
		summarizeBy: sum
		sourceColumn: LibraryUtilizationPct

	column TutorHoursAvailable
		dataType: int64
		summarizeBy: sum
		sourceColumn: TutorHoursAvailable

	column TutorHoursRecommended
		dataType: int64
		summarizeBy: sum
		sourceColumn: TutorHoursRecommended

	column TutorHourGap
		dataType: int64
		summarizeBy: sum
		sourceColumn: TutorHourGap

	column SupportFlagCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: SupportFlagCount

	column ResourceGapScore
		dataType: int64
		summarizeBy: sum
		sourceColumn: ResourceGapScore

	partition resource_allocation = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"AcademicYear", Int64.Type}, {"Term", Int64.Type}, {"Department", type text}, {"StudentCount", Int64.Type}, {"FacultyCount", Int64.Type}, {"FacultyRecommended", Int64.Type}, {"LabCapacityHours", Int64.Type}, {"LabHoursUsed", Int64.Type}, {"LabUtilizationPct", type number}, {"LibraryVisits", Int64.Type}, {"LibraryVisitsCapacity", Int64.Type}, {"LibraryUtilizationPct", type number}, {"TutorHoursAvailable", Int64.Type}, {"TutorHoursRecommended", Int64.Type}, {"TutorHourGap", Int64.Type}, {"SupportFlagCount", Int64.Type}, {"ResourceGapScore", Int64.Type}}, "en-US")
			in
				#"Changed Type"
