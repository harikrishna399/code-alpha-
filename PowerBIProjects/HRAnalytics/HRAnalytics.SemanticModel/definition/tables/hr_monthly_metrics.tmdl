table hr_monthly_metrics
	measure 'Total Hires' = SUM(hr_monthly_metrics[Hires])
		formatString: #,##0

	measure 'Total Exits' = SUM(hr_monthly_metrics[Exits])
		formatString: #,##0

	measure 'Employee Turnover Rate %' = DIVIDE(AVERAGE(hr_monthly_metrics[TurnoverRatePct]), 100, 0)
		formatString: 0.0%

	measure 'Recruitment Conversion %' = DIVIDE(SUM(hr_monthly_metrics[Offers]), SUM(hr_monthly_metrics[Applications]), 0)
		formatString: 0.0%

	measure 'Forecast Hiring Need' = SUM(hr_monthly_metrics[ForecastHires])
		formatString: #,##0

	measure 'Total Applications' = SUM(hr_monthly_metrics[Applications])
		formatString: #,##0

	measure 'Total Offers' = SUM(hr_monthly_metrics[Offers])
		formatString: #,##0

	measure 'Average Time to Fill' = AVERAGE(hr_monthly_metrics[AverageTimeToFillDays])
		formatString: 0.0

	measure 'Average Satisfaction' = AVERAGE(hr_monthly_metrics[SatisfactionScore])
		formatString: 0.00

	measure 'Average Performance Rating' = AVERAGE(hr_monthly_metrics[PerformanceRating])
		formatString: 0.00

	column Month
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Month
		formatString: yyyy-mm-dd

	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	column RecordType
		dataType: string
		summarizeBy: none
		sourceColumn: RecordType

	column OpeningHeadcount
		dataType: int64
		summarizeBy: sum
		sourceColumn: OpeningHeadcount

	column Hires
		dataType: int64
		summarizeBy: sum
		sourceColumn: Hires

	column Exits
		dataType: int64
		summarizeBy: sum
		sourceColumn: Exits

	column ClosingHeadcount
		dataType: int64
		summarizeBy: sum
		sourceColumn: ClosingHeadcount

	column Applications
		dataType: int64
		summarizeBy: sum
		sourceColumn: Applications

	column Offers
		dataType: int64
		summarizeBy: sum
		sourceColumn: Offers

	column Requisitions
		dataType: int64
		summarizeBy: sum
		sourceColumn: Requisitions

	column AverageTimeToFillDays
		dataType: int64
		summarizeBy: sum
		sourceColumn: AverageTimeToFillDays

	column PlannedHeadcount
		dataType: int64
		summarizeBy: sum
		sourceColumn: PlannedHeadcount

	column ForecastHires
		dataType: int64
		summarizeBy: sum
		sourceColumn: ForecastHires

	column TurnoverRatePct
		dataType: double
		summarizeBy: sum
		sourceColumn: TurnoverRatePct

	column SatisfactionScore
		dataType: double
		summarizeBy: sum
		sourceColumn: SatisfactionScore

	column PerformanceRating
		dataType: double
		summarizeBy: sum
		sourceColumn: PerformanceRating

	column TrainingHours
		dataType: int64
		summarizeBy: sum
		sourceColumn: TrainingHours

	partition hr_monthly_metrics = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Month", type date}, {"Department", type text}, {"RecordType", type text}, {"OpeningHeadcount", Int64.Type}, {"Hires", Int64.Type}, {"Exits", Int64.Type}, {"ClosingHeadcount", Int64.Type}, {"Applications", Int64.Type}, {"Offers", Int64.Type}, {"Requisitions", Int64.Type}, {"AverageTimeToFillDays", Int64.Type}, {"PlannedHeadcount", Int64.Type}, {"ForecastHires", Int64.Type}, {"TurnoverRatePct", type number}, {"SatisfactionScore", type number}, {"PerformanceRating", type number}, {"TrainingHours", Int64.Type}}, "en-US")
			in
				#"Changed Type"
