table hr_employee_data
	column EmployeeID
		dataType: string
		summarizeBy: none
		sourceColumn: EmployeeID

	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	column JobRole
		dataType: string
		summarizeBy: none
		sourceColumn: JobRole

	column Location
		dataType: string
		summarizeBy: none
		sourceColumn: Location

	column HireDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: HireDate
		formatString: yyyy-mm-dd

	column ExitDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: ExitDate
		formatString: yyyy-mm-dd

	column EmploymentStatus
		dataType: string
		summarizeBy: none
		sourceColumn: EmploymentStatus

	column RecruitmentSource
		dataType: string
		summarizeBy: none
		sourceColumn: RecruitmentSource

	column PerformanceRating
		dataType: int64
		summarizeBy: sum
		sourceColumn: PerformanceRating

	column SatisfactionScore
		dataType: double
		summarizeBy: sum
		sourceColumn: SatisfactionScore

	column TrainingHours
		dataType: int64
		summarizeBy: sum
		sourceColumn: TrainingHours

	column MonthlySalary
		dataType: int64
		summarizeBy: sum
		sourceColumn: MonthlySalary

	partition hr_employee_data = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"EmployeeID", type text}, {"Department", type text}, {"JobRole", type text}, {"Location", type text}, {"HireDate", type date}, {"ExitDate", type date}, {"EmploymentStatus", type text}, {"RecruitmentSource", type text}, {"PerformanceRating", Int64.Type}, {"SatisfactionScore", type number}, {"TrainingHours", Int64.Type}, {"MonthlySalary", Int64.Type}}, "en-US")
			in
				#"Changed Type"
