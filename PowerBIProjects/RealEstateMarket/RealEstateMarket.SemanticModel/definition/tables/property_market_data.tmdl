table property_market_data
	measure 'Average Sale Price' = AVERAGE(property_market_data[AverageSalePrice])
		formatString: ₹ #,##0

	measure 'Average Monthly Rent' = AVERAGE(property_market_data[AverageMonthlyRent])
		formatString: ₹ #,##0

	measure 'Gross Rental Yield %' = DIVIDE(AVERAGE(property_market_data[AverageMonthlyRent]) * 12, AVERAGE(property_market_data[AverageSalePrice]), 0)
		formatString: 0.00%

	measure 'Total Listings' = SUM(property_market_data[Listings])
		formatString: #,##0

	measure 'Total Transactions' = SUM(property_market_data[Transactions])
		formatString: #,##0

	measure 'Demand to Supply Ratio' = DIVIDE([Total Transactions], [Total Listings], 0)
		formatString: 0.00

	measure 'Average Policy Rate %' = AVERAGE(property_market_data[PolicyRatePct]) / 100
		formatString: 0.00%

	column Month
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Month
		formatString: yyyy-mm-dd

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: City

	column Neighborhood
		dataType: string
		summarizeBy: none
		sourceColumn: Neighborhood

	column PropertyType
		dataType: string
		summarizeBy: none
		sourceColumn: PropertyType

	column AverageSalePrice
		dataType: int64
		summarizeBy: sum
		sourceColumn: AverageSalePrice

	column AverageMonthlyRent
		dataType: int64
		summarizeBy: sum
		sourceColumn: AverageMonthlyRent

	column Listings
		dataType: int64
		summarizeBy: sum
		sourceColumn: Listings

	column Transactions
		dataType: int64
		summarizeBy: sum
		sourceColumn: Transactions

	column PopulationIndex
		dataType: int64
		summarizeBy: sum
		sourceColumn: PopulationIndex

	column PolicyRatePct
		dataType: double
		summarizeBy: sum
		sourceColumn: PolicyRatePct

	column Latitude
		dataType: double
		summarizeBy: none
		sourceColumn: Latitude

	column Longitude
		dataType: double
		summarizeBy: none
		sourceColumn: Longitude

	column RecordType
		dataType: string
		summarizeBy: none
		sourceColumn: RecordType

	partition property_market_data = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Month", type date}, {"City", type text}, {"Neighborhood", type text}, {"PropertyType", type text}, {"AverageSalePrice", Int64.Type}, {"AverageMonthlyRent", Int64.Type}, {"Listings", Int64.Type}, {"Transactions", Int64.Type}, {"PopulationIndex", Int64.Type}, {"PolicyRatePct", type number}, {"Latitude", type number}, {"Longitude", type number}, {"RecordType", type text}}, "en-US")
			in
				#"Changed Type"
