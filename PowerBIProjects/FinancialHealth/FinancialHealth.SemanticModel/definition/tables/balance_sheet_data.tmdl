table balance_sheet_data
	measure 'Total Assets' = SUM(balance_sheet_data[TotalAssets])
		formatString: ₹ #,##0

	measure 'Total Liabilities' = SUM(balance_sheet_data[TotalLiabilities])
		formatString: ₹ #,##0

	measure 'Shareholders Equity' = SUM(balance_sheet_data[ShareholdersEquity])
		formatString: ₹ #,##0

	measure 'Balance Check' = SUM(balance_sheet_data[BalanceCheck])
		formatString: ₹ #,##0

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date
		formatString: yyyy-mm-dd

	column Cash
		dataType: int64
		summarizeBy: sum
		sourceColumn: Cash

	column AccountsReceivable
		dataType: int64
		summarizeBy: sum
		sourceColumn: AccountsReceivable

	column Inventory
		dataType: int64
		summarizeBy: sum
		sourceColumn: Inventory

	column PropertyPlantEquipment
		dataType: int64
		summarizeBy: sum
		sourceColumn: PropertyPlantEquipment

	column TotalAssets
		dataType: int64
		summarizeBy: sum
		sourceColumn: TotalAssets

	column AccountsPayable
		dataType: int64
		summarizeBy: sum
		sourceColumn: AccountsPayable

	column ShortTermDebt
		dataType: int64
		summarizeBy: sum
		sourceColumn: ShortTermDebt

	column LongTermDebt
		dataType: int64
		summarizeBy: sum
		sourceColumn: LongTermDebt

	column TotalLiabilities
		dataType: int64
		summarizeBy: sum
		sourceColumn: TotalLiabilities

	column ShareholdersEquity
		dataType: int64
		summarizeBy: sum
		sourceColumn: ShareholdersEquity

	column TotalLiabilitiesAndEquity
		dataType: int64
		summarizeBy: sum
		sourceColumn: TotalLiabilitiesAndEquity

	column BalanceCheck
		dataType: int64
		summarizeBy: sum
		sourceColumn: BalanceCheck

	partition balance_sheet_data = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Date", type date}, {"Cash", Int64.Type}, {"AccountsReceivable", Int64.Type}, {"Inventory", Int64.Type}, {"PropertyPlantEquipment", Int64.Type}, {"TotalAssets", Int64.Type}, {"AccountsPayable", Int64.Type}, {"ShortTermDebt", Int64.Type}, {"LongTermDebt", Int64.Type}, {"TotalLiabilities", Int64.Type}, {"ShareholdersEquity", Int64.Type}, {"TotalLiabilitiesAndEquity", Int64.Type}, {"BalanceCheck", Int64.Type}}, "en-US")
			in
				#"Changed Type"
