table cash_flow_data
	measure 'Net Cash Flow' = SUM(cash_flow_data[NetCashFlow])
		formatString: ₹ #,##0

	measure 'Closing Cash Latest' = CALCULATE(MAX(cash_flow_data[ClosingCash]), LASTDATE(DateTable[Date]))
		formatString: ₹ #,##0

	measure 'Operating Cash Flow' = SUM(cash_flow_data[OperatingCashFlow])
		formatString: ₹ #,##0

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date
		formatString: yyyy-mm-dd

	column OpeningCash
		dataType: int64
		summarizeBy: sum
		sourceColumn: OpeningCash

	column OperatingCashFlow
		dataType: int64
		summarizeBy: sum
		sourceColumn: OperatingCashFlow

	column InvestingCashFlow
		dataType: int64
		summarizeBy: sum
		sourceColumn: InvestingCashFlow

	column FinancingCashFlow
		dataType: int64
		summarizeBy: sum
		sourceColumn: FinancingCashFlow

	column NetCashFlow
		dataType: int64
		summarizeBy: sum
		sourceColumn: NetCashFlow

	column ClosingCash
		dataType: int64
		summarizeBy: sum
		sourceColumn: ClosingCash

	partition cash_flow_data = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Date", type date}, {"OpeningCash", Int64.Type}, {"OperatingCashFlow", Int64.Type}, {"InvestingCashFlow", Int64.Type}, {"FinancingCashFlow", Int64.Type}, {"NetCashFlow", Int64.Type}, {"ClosingCash", Int64.Type}}, "en-US")
			in
				#"Changed Type"
