table income_statement_data
	measure 'Total Revenue' = SUM(income_statement_data[Revenue])
		formatString: ₹ #,##0

	measure 'Total Expenses' = SUM(income_statement_data[TotalExpenses])
		formatString: ₹ #,##0

	measure 'Net Profit' = SUM(income_statement_data[NetIncome])
		formatString: ₹ #,##0

	measure 'Profit Margin %' = DIVIDE([Net Profit], [Total Revenue], 0)
		formatString: 0.0%

	measure 'Revenue Budget' = SUM(income_statement_data[BudgetRevenue])
		formatString: ₹ #,##0

	measure 'Expense Budget' = SUM(income_statement_data[BudgetExpenses])
		formatString: ₹ #,##0

	measure 'Revenue Variance' = [Total Revenue] - [Revenue Budget]
		formatString: ₹ #,##0

	measure 'Expense Variance' = [Total Expenses] - [Expense Budget]
		formatString: ₹ #,##0

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date
		formatString: yyyy-mm-dd

	column Revenue
		dataType: int64
		summarizeBy: sum
		sourceColumn: Revenue

	column CostOfGoodsSold
		dataType: int64
		summarizeBy: sum
		sourceColumn: CostOfGoodsSold

	column OperatingExpenses
		dataType: int64
		summarizeBy: sum
		sourceColumn: OperatingExpenses

	column OtherExpenses
		dataType: int64
		summarizeBy: sum
		sourceColumn: OtherExpenses

	column Depreciation
		dataType: int64
		summarizeBy: sum
		sourceColumn: Depreciation

	column InterestExpense
		dataType: int64
		summarizeBy: sum
		sourceColumn: InterestExpense

	column IncomeTax
		dataType: int64
		summarizeBy: sum
		sourceColumn: IncomeTax

	column TotalExpenses
		dataType: int64
		summarizeBy: sum
		sourceColumn: TotalExpenses

	column NetIncome
		dataType: int64
		summarizeBy: sum
		sourceColumn: NetIncome

	column BudgetRevenue
		dataType: int64
		summarizeBy: sum
		sourceColumn: BudgetRevenue

	column BudgetExpenses
		dataType: int64
		summarizeBy: sum
		sourceColumn: BudgetExpenses

	partition income_statement_data = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Date", type date}, {"Revenue", Int64.Type}, {"CostOfGoodsSold", Int64.Type}, {"OperatingExpenses", Int64.Type}, {"OtherExpenses", Int64.Type}, {"Depreciation", Int64.Type}, {"InterestExpense", Int64.Type}, {"IncomeTax", Int64.Type}, {"TotalExpenses", Int64.Type}, {"NetIncome", Int64.Type}, {"BudgetRevenue", Int64.Type}, {"BudgetExpenses", Int64.Type}}, "en-US")
			in
				#"Changed Type"
