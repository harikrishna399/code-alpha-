-- Create these measures after importing financial_data.csv.
Total Revenue = SUM(financial_data[Revenue])

Operating Expenses = SUM(financial_data[OperatingExpenses])

Other Expenses = SUM(financial_data[OtherExpenses])

Total Expenses = [Operating Expenses] + [Other Expenses]

Net Profit = [Total Revenue] - [Total Expenses]

Profit Margin % = DIVIDE([Net Profit], [Total Revenue], 0)

Revenue Budget = SUM(financial_data[BudgetRevenue])

Expense Budget = SUM(financial_data[BudgetExpenses])

Revenue vs Budget = [Total Revenue] - [Revenue Budget]

Expense vs Budget = [Total Expenses] - [Expense Budget]

Cash Change = SUM(financial_data[ClosingCash]) - SUM(financial_data[OpeningCash])

-- Optional month-over-month growth. Create a proper Date table and mark it as a date table first.
Revenue Previous Month =
CALCULATE([Total Revenue], DATEADD('Date'[Date], -1, MONTH))

Revenue MoM % =
DIVIDE([Total Revenue] - [Revenue Previous Month], [Revenue Previous Month], 0)

-- Note: Cash Change above is a row-sum style indicator, not a cash-flow statement.
-- For a true cash-flow statement, model cash inflows/outflows as separate transaction rows.